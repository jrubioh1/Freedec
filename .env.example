# ==============================================================================
# FREEDEC - CONFIGURACIÓN DE ENTORNO Y SMTP (STAGING / PRODUCCIÓN)
# ==============================================================================
# Copia este archivo a '.env' en la raíz del proyecto para activar tu configuración:
#   cp .env.example .env
#
# Para probar el envío de correo de inmediato tras configurar .env:
#   poetry run python manage.py test_smtp tu-correo@gmail.com
# ==============================================================================

# Clave secreta de Django (opcional en staging, obligatoria en producción)
DJANGO_SECRET_KEY=django-insecure-staging-key-freedec-cybersec-demo-2026!#@$

# Clave maestra criptográfica Fernet de 32 bytes en base64 url-safe
# Genera una nueva con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FREEDEC_FERNET_KEY=OE2bpfNsxK36xJUha369orE4qOZkCpEVYgMpjiUkNB8=

# ------------------------------------------------------------------------------
# OPCIÓN 1: GMAIL (Google Mail)
# Requiere activar Verificación en 2 pasos y crear una "Contraseña de Aplicación"
# de 16 caracteres en: https://myaccount.google.com/apppasswords
# No uses tu contraseña personal habitual de Gmail.
# ------------------------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=tu_correo@gmail.com
# EMAIL_HOST_PASSWORD=abcd efgh ijkl mnop
# DEFAULT_FROM_EMAIL=tu_correo@gmail.com

# ------------------------------------------------------------------------------
# OPCIÓN 2: BREVO / SENDINBLUE (Recomendado para pruebas gratis - 300 mails/día)
# Cuenta gratis en https://www.brevo.com -> Menú superior derecho -> SMTP & API
# ------------------------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=7a8b9c@smtp-brevo.com
# EMAIL_HOST_PASSWORD=tu_clave_smtp_de_brevo
# DEFAULT_FROM_EMAIL=tu_correo_remitente_validado@tudominio.com

# ------------------------------------------------------------------------------
# OPCIÓN 3: OUTLOOK / OFFICE 365
# ------------------------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=tu_correo@outlook.com
# EMAIL_HOST_PASSWORD=tu_contraseña
# DEFAULT_FROM_EMAIL=tu_correo@outlook.com

# ------------------------------------------------------------------------------
# OPCIÓN 4: MAILPIT (Servidor SMTP local para ver correos en una web local)
# docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
# Luego abre http://localhost:8025 para ver los emails recibidos
# ------------------------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=127.0.0.1
# EMAIL_PORT=1025
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=no-reply@freedec.local

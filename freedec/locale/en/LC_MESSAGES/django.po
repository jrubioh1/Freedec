msgid ""
"El archivo proporcionado no coincide con el hash SHA-256 del documento "
"original."
msgstr "The provided file does not match the SHA-256 hash of the original document."

#: freedec/services.py:220
#, python-format
msgid "El archivo excede el tamaño máximo permitido de %(max_size)s MB."
msgstr "The file exceeds the maximum allowed size of %(max_size)s MB."


#: freedec/admin.py:127
msgid "Archivo Documental Original"
msgstr "Original Document File"

#: freedec/admin.py:129
msgid ""
"Formatos admitidos: PDF, LibreOffice (.odt, .ods, .odp, .odg) o Microsoft "
"Office (.docx, .xlsx, .pptx, .doc, .xls, .ppt)."
msgstr ""
"Supported formats: PDF, LibreOffice (.odt, .ods, .odp, .odg), or Microsoft "
"Office (.docx, .xlsx, .pptx, .doc, .xls, .ppt)."

#: freedec/admin.py:133
msgid "Contraseña (Opcional)"
msgstr "Password (Optional)"

#: freedec/admin.py:136
msgid "Dejar en blanco para autogenerar una clave segura..."
msgstr "Leave blank to auto-generate a secure key..."

#: freedec/admin.py:139
msgid ""
"Opcional. Si se deja en blanco, el sistema genera automáticamente una clave "
"de 24 caracteres."
msgstr ""
"Optional. If left blank, the system automatically generates a 24-character "
"key."

#: freedec/admin.py:143 freedec/admin.py:176
msgid "Correos Autorizados"
msgstr "Authorized Emails"

#: freedec/admin.py:146
msgid ""
"Destinatarios autorizados. Use '+' para añadir más direcciones (sin JSON)."
msgstr "Authorized recipients. Use '+' to add more addresses (no JSON)."

#: freedec/admin.py:179
msgid "Destinatarios autorizados. Use '+' para añadir o modificar direcciones."
msgstr "Authorized recipients. Use '+' to add or modify addresses."

#: freedec/admin.py:204
msgid "Registro de acceso"
msgstr "Access Log"

#: freedec/admin.py:205
msgid "Historial de accesos y trazabilidad de clave"
msgstr "Access history and key traceability"

#: freedec/admin.py:245
msgid "Cifrado y Registro de Nuevo Documento"
msgstr "Encryption and New Document Registration"

#: freedec/admin.py:249
msgid ""
"Suba el archivo original. La contraseña y el código de acceso se generarán "
"automáticamente mediante algoritmos de alta entropía."
msgstr ""
"Upload the original file. The password and access code will be generated "
"automatically using high-entropy algorithms."

#: freedec/admin.py:256
msgid "Nombre e Identificación Criptográfica"
msgstr "Cryptographic Name and Identification"

#: freedec/admin.py:259
msgid "Nombre original y hash SHA-256 del archivo calculado en la subida."
msgstr "Original filename and SHA-256 hash calculated during upload."

#: freedec/admin.py:263
msgid "Almacenamiento Cifrado"
msgstr "Encrypted Storage"

#: freedec/admin.py:267
msgid ""
"El archivo y la contraseña se encuentran cifrados en reposo con Fernet "
"(AES-128-CBC + HMAC)."
msgstr ""
"The file and password are encrypted at rest with Fernet (AES-128-CBC + HMAC)."

#: freedec/admin.py:272
msgid "Seguridad y Control de Acceso"
msgstr "Security and Access Control"

#: freedec/admin.py:276
msgid ""
"El código de acceso se almacena mediante hash PBKDF2 (Zero-Knowledge). Los "
"correos pueden modificarse usando el botón '+'."
msgstr ""
"The access code is stored using PBKDF2 hash (Zero-Knowledge). Emails can be "
"modified using the '+' button."

#: freedec/admin.py:281
msgid "Auditoría y Trazabilidad de Accesos"
msgstr "Access Audit and Traceability"

#: freedec/admin.py:291
msgid ""
"Registro de actividad y fecha del último acceso o despacho de contraseña."
msgstr "Activity log and date of last access or password dispatch."

#: freedec/admin.py:454 freedec/models.py:42
msgid "Hash SHA-256"
msgstr "SHA-256 Hash"

#: freedec/admin.py:458
msgid "Descargar Cifrado"
msgstr "Download Encrypted"

#: freedec/admin.py:470
msgid "Eliminar"
msgstr "Delete"

#: freedec/forms.py:18 freedec/models.py:141
msgid "Documento"
msgstr "Document"

#: freedec/forms.py:19
msgid "Seleccione el archivo que desea consultar."
msgstr "Select the file you want to verify."

#: freedec/forms.py:23
msgid "Código de Acceso"
msgstr "Access Code"

#: freedec/forms.py:27
msgid "Introduzca su código de acceso..."
msgstr "Enter your access code..."

#: freedec/forms.py:32
msgid "Código facilitado por el emisor del documento."
msgstr "Code provided by the document sender."

#: freedec/forms.py:35
msgid "Correo Electrónico"
msgstr "Email Address"

#: freedec/forms.py:39
msgid "su-correo@ejemplo.com"
msgstr "your-email@example.com"

#: freedec/forms.py:43
msgid "Dirección de correo donde se enviará la contraseña."
msgstr "Email address where the password will be sent."

#: freedec/forms.py:49 freedec/forms.py:97
msgid "Debe proporcionar un archivo."
msgstr "You must provide a file."

#: freedec/forms.py:55 freedec/forms.py:103 freedec/services.py:223
#, python-format
msgid "El archivo excede el tamaño máximo permitido de %(max_size)s MB."
msgstr "The file exceeds the maximum allowed size of %(max_size)s MB."

#: freedec/forms.py:77
msgid "Archivo Cifrado (.enc)"
msgstr "Encrypted File (.enc)"

#: freedec/forms.py:78
msgid "Seleccione el archivo con extensión .enc que desea descifrar."
msgstr "Select the .enc file you want to decrypt."

#: freedec/forms.py:82
msgid "Contraseña de Descifrado"
msgstr "Decryption Password"

#: freedec/forms.py:86
msgid "Pegue la contraseña recibida por correo..."
msgstr "Paste the password received by email..."

#: freedec/forms.py:91
msgid ""
"Contraseña que le fue remitida a su correo electrónico tras la verificación."
msgstr "Password sent to your email after verification."

#: freedec/forms.py:111
msgid "Debe introducir la contraseña de descifrado."
msgstr "You must enter the decryption password."

#: freedec/models.py:35
msgid "Nombre original del archivo"
msgstr "Original filename"

#: freedec/models.py:36
msgid "Nombre del archivo original subido por el administrador."
msgstr "Original filename uploaded by the administrator."

#: freedec/models.py:43
msgid ""
"Hash SHA-256 hexadecimal (64 caracteres) del archivo original sin cifrar."
msgstr ""
"64-character hexadecimal SHA-256 hash of the original unencrypted file."

#: freedec/models.py:47
msgid "Archivo cifrado"
msgstr "Encrypted file"

#: freedec/models.py:48
msgid "Archivo binario cifrado en reposo con Fernet (AES-128-CBC + HMAC)."
msgstr "Binary file encrypted at rest with Fernet (AES-128-CBC + HMAC)."

#: freedec/models.py:52
msgid "Código de acceso"
msgstr "Access code"

#: freedec/models.py:53
msgid ""
"Hash PBKDF2 del código secreto de acceso necesario para la verificación."
msgstr "PBKDF2 hash of the secret access code required for verification."

#: freedec/models.py:56
msgid "Contraseña cifrada"
msgstr "Encrypted password"

#: freedec/models.py:57
msgid "Contraseña o clave de descifrado cifrada con Fernet (token seguro)."
msgstr "Password or decryption key encrypted with Fernet (secure token)."

#: freedec/models.py:61
msgid "Correos autorizados"
msgstr "Authorized emails"

#: freedec/models.py:62
msgid "Lista de correos electrónicos autorizados en formato JSON (minúsculas)."
msgstr "List of authorized email addresses in JSON format (lowercase)."

#: freedec/models.py:66
msgid "Veces accedido"
msgstr "Access count"

#: freedec/models.py:67
msgid "Número total de solicitudes de contraseña o descifrados autorizados."
msgstr "Total number of password requests or authorized decryptions."

#: freedec/models.py:72
msgid "Último acceso"
msgstr "Last access"

#: freedec/models.py:73
msgid "Fecha y hora de la última solicitud de contraseña o descifrado."
msgstr "Date and time of the last password request or decryption."

#: freedec/models.py:79
msgid "Último correo que accedió"
msgstr "Last accessing email"

#: freedec/models.py:80
msgid "Dirección de correo del último usuario que solicitó la clave."
msgstr "Email address of the last user who requested the key."

#: freedec/models.py:84
msgid "Fecha de creación"
msgstr "Creation date"

#: freedec/models.py:85
msgid "Fecha y hora de registro y cifrado del documento."
msgstr "Date and time of document registration and encryption."

#: freedec/models.py:89
msgid "Fecha de actualización"
msgstr "Update date"

#: freedec/models.py:90
msgid "Fecha y hora de la última modificación del registro."
msgstr "Date and time of the last record modification."

#: freedec/models.py:94
msgid "Documento Cifrado"
msgstr "Encrypted Document"

#: freedec/models.py:95
msgid "Documentos Cifrados"
msgstr "Encrypted Documents"

#: freedec/models.py:145
msgid "Correo solicitante"
msgstr "Requesting email"

#: freedec/models.py:150
msgid "Acción"
msgstr "Action"

#: freedec/models.py:151
msgid "Tipo de evento: 'solicitud_clave' o 'descifrado'."
msgstr "Event type: 'solicitud_clave' or 'descifrado'."

#: freedec/models.py:156
msgid "Dirección IP"
msgstr "IP Address"

#: freedec/models.py:160
msgid "Fecha y hora de acceso"
msgstr "Access timestamp"

#: freedec/models.py:164
msgid "Registro de Auditoría de Acceso"
msgstr "Access Audit Log"

#: freedec/models.py:165
msgid "Registros de Auditoría de Accesos"
msgstr "Access Audit Logs"

#: freedec/services.py:235
#, python-format
msgid "Ya existe un documento registrado con el hash SHA-256: %(file_hash)s."
msgstr "A document is already registered with SHA-256 hash: %(file_hash)s."

#: freedec/services.py:317
msgid "El archivo supera el tamaño máximo permitido."
msgstr "The file exceeds the maximum allowed size."

#: freedec/services.py:321
msgid ""
"Si el archivo, el código de acceso y el correo electrónico coinciden con los "
"registros autorizados, la clave de descifrado ha sido enviada a su buzón."
msgstr ""
"If the file, access code, and email match the authorized records, the "
"decryption key has been sent to your inbox."

#: freedec/services.py:398
msgid "Error interno en el procesamiento criptográfico."
msgstr "Internal error in cryptographic processing."

#: freedec/services.py:419
#, python-format
msgid "[Freedec] Clave de recuperación para su documento: %(doc_name)s"
msgstr "[Freedec] Recovery key for your document: %(doc_name)s"

#: freedec/services.py:431
msgid "Estimado usuario,"
msgstr "Dear user,"

#: freedec/services.py:432
msgid "Se ha verificado con éxito su documento y su autorización de acceso."
msgstr ""
"Your document and access authorization have been successfully verified."

#: freedec/services.py:433
#, python-format
msgid "📄 Nombre del archivo: %(doc_name)s"
msgstr "📄 File name: %(doc_name)s"

#: freedec/services.py:434
msgid "Su contraseña o clave de descifrado es:"
msgstr "Your password or decryption key is:"

#: freedec/services.py:440
#, python-format
msgid ""
"Para descifrar su archivo '%(enc_name)s' y recuperar el documento original "
"sin cifrar, puede acceder al portal público en la pestaña 'Descifrar Archivo "
"(.enc)':"
msgstr ""
"To decrypt your file '%(enc_name)s' and recover the original unencrypted "
"document, you can access the public portal under the 'Decrypt File (.enc)' "
"tab:"

#: freedec/services.py:446
msgid "Por motivos de seguridad, no comparta esta clave con terceros."
msgstr "For security reasons, do not share this key with third parties."

#: freedec/services.py:447
msgid "Atentamente,"
msgstr "Sincerely,"

#: freedec/services.py:448
msgid "Sistema Automatizado Freedec"
msgstr "Freedec Automated System"

#: freedec/services.py:466
msgid "Error de validación en los parámetros del mensaje de correo."
msgstr "Validation error in email message parameters."

#: freedec/services.py:469
msgid "Error al enviar el correo electrónico con las credenciales."
msgstr "Error sending the email with credentials."

#: freedec/services.py:496
msgid "Debe proporcionar la contraseña de descifrado recibida por correo."
msgstr "You must provide the decryption password received by email."

#: freedec/services.py:508
msgid "El archivo cifrado está vacío."
msgstr "The encrypted file is empty."

#: freedec/services.py:514
msgid "El archivo no es un archivo cifrado válido de Freedec o está dañado."
msgstr "The file is not a valid Freedec encrypted file or is corrupted."

#: freedec/services.py:521
msgid "No se encontró ningún registro correspondiente a este archivo."
msgstr "No record found corresponding to this file."

#: freedec/services.py:528
msgid "Error interno en la verificación criptográfica."
msgstr "Internal error in cryptographic verification."

#: freedec/services.py:532
msgid "La contraseña introducida no coincide con la clave del documento."
msgstr "The entered password does not match the document key."

#: freedec/services.py:555
msgid "Documento descifrado correctamente."
msgstr "Document decrypted successfully."

#: freedec/templates/freedec/base.html:7
msgid "Freedec - Cifrado y Recuperación Segura"
msgstr "Freedec - Secure Encryption & Recovery"

#: freedec/templates/freedec/base.html:346
#: freedec/templates/freedec/public_decrypt.html:74
#: freedec/templates/freedec/public_request.html:93
msgid "Solicitar Contraseña"
msgstr "Request Password"

#: freedec/templates/freedec/base.html:347
msgid "Descifrar Archivo (.enc)"
msgstr "Decrypt File (.enc)"

#: freedec/templates/freedec/base.html:371
msgid ""
"Freedec &copy; 2026 &mdash; Servicio de Verificación Criptográfica y "
"Recuperación de Contraseñas"
msgstr ""
"Freedec &copy; 2026 &mdash; Cryptographic Verification and Password Recovery "
"Service"

#: freedec/templates/freedec/base.html:379
msgid "✓ ¡Copiado!"
msgstr "✓ Copied!"

#: freedec/templates/freedec/public_decrypt.html:4
msgid "Descifrar Documento (.enc)"
msgstr "Decrypt Document (.enc)"

#: freedec/templates/freedec/public_decrypt.html:11
msgid "Descifrar Archivo Cifrado"
msgstr "Decrypt Encrypted File"

#: freedec/templates/freedec/public_decrypt.html:13
msgid "Descarga Segura"
msgstr "Secure Download"

#: freedec/templates/freedec/public_decrypt.html:16
msgid ""
"Suba el archivo protegido (<strong>.enc</strong>) y la contraseña que le "
"enviamos a su correo para recuperar y descargar el documento original."
msgstr ""
"Upload the protected file (<strong>.enc</strong>) and the password sent to "
"your email to recover and download the original document."

#: freedec/templates/freedec/public_decrypt.html:23
msgid "Error en el descifrado:"
msgstr "Decryption error:"

#: freedec/templates/freedec/public_decrypt.html:67
msgid "Descifrar y Descargar Archivo Original"
msgstr "Decrypt and Download Original File"

#: freedec/templates/freedec/public_decrypt.html:72
msgid "¿Aún no tienes la contraseña?"
msgstr "Don't have the password yet?"

#: freedec/templates/freedec/public_decrypt.html:74
msgid "Si tienes el archivo pero no has solicitado la contraseña, ve a"
msgstr "If you have the file but have not requested the password, go to"

#: freedec/templates/freedec/public_decrypt.html:74
msgid ""
"sube tu archivo e introduce tu código de acceso para recibirla en tu correo "
"electrónico."
msgstr ""
"upload your file and enter your access code to receive it in your email."

#: freedec/templates/freedec/public_request.html:4
#: freedec/templates/freedec/public_request.html:11
msgid "Entrega Segura de Contraseña"
msgstr "Secure Password Delivery"

#: freedec/templates/freedec/public_request.html:13
msgid "Portal de Usuario"
msgstr "User Portal"

#: freedec/templates/freedec/public_request.html:16
msgid ""
"Proporcione el documento correspondiente, su código de acceso y su correo "
"electrónico registrado para recibir la clave de descifrado."
msgstr ""
"Provide the corresponding document, your access code, and your registered "
"email to receive the decryption key."

#: freedec/templates/freedec/public_request.html:24
msgid "Estado de la Solicitud:"
msgstr "Request Status:"

#: freedec/templates/freedec/public_request.html:30
msgid "Información de Entrega:"
msgstr "Delivery Information:"

#: freedec/templates/freedec/public_request.html:32
msgid ""
"Por motivos de confidencialidad, la clave nunca se muestra en pantalla. Si "
"el archivo y los datos facilitados corresponden a un registro autorizado, la "
"contraseña habrá sido remitida a su bandeja de entrada."
msgstr ""
"For confidentiality reasons, the key is never displayed on screen. If the "
"provided file and details match an authorized record, the password has been "
"sent to your inbox."

#: freedec/templates/freedec/public_request.html:37
msgid "Realizar Otra Solicitud"
msgstr "Make Another Request"

